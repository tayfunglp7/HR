@model HR.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}


<div class="row g-4 mb-4">

    <div class="col-md-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Toplam Personel
                        </div>

                        <div class="fs-2 fw-bold">
                            @Model.ToplamPersonelSayisi
                        </div>
                    </div>

                    <div class="fs-1 text-primary">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Bekleyen İzin Talepleri
                        </div>

                        <div class="fs-2 fw-bold">
                            @Model.BekleyenIzinSayisi
                        </div>
                    </div>

                    <div class="fs-1 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted small">
                            Bu Ay İzinde Olan Personel
                        </div>

                        <div class="fs-2 fw-bold">
                            @Model.BuAyIzindeOlanPersonelSayisi
                        </div>
                    </div>

                    <div class="fs-1 text-success">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<div class="row g-4">

    <div class="col-lg-7">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-bar-chart"></i>
                    Departmanlara Göre Personel Dağılımı
                </h5>

            </div>

            <div class="card-body">

                @if (Model.DepartmanDagilimi.Count == 0)
                {
                    <div class="text-center text-muted py-5">
                        Henüz departman bulunmuyor.
                    </div>
                }
                else
                {
                    <div style="height: 350px;">
                        <canvas id="departmanGrafik"></canvas>
                    </div>
                }

            </div>

        </div>

    </div>

    <div class="col-lg-5">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-clock-history"></i>
                    Son 5 Bekleyen İzin
                </h5>

            </div>

            <div class="card-body">

                @if (Model.BekleyenIzinler.Count == 0)
                {
                    <div class="text-center text-muted py-4">

                        <i class="bi bi-check-circle fs-1 d-block mb-2"></i>

                        <div>
                            Bekleyen izin bulunmuyor.
                        </div>

                    </div>
                }
                else
                {
                    @foreach (var izin in Model.BekleyenIzinler)
                    {
                        <div class="border-bottom pb-3 mb-3">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>

                                    <div class="fw-semibold">
                                        @izin.PersonelAdSoyad
                                    </div>

                                    <div class="small text-muted">
                                        @izin.DepartmanAdi
                                    </div>

                                </div>

                                <span class="badge bg-warning text-dark">
                                    Beklemede
                                </span>

                            </div>


                            <div class="small mt-2 text-muted">

                                <span>
                                    @izin.IzinTipi
                                </span>

                                <span class="mx-1">•</span>

                                <span>
                                    @izin.BaslangicTarihi.ToString("dd.MM.yyyy")
                                </span>

                                <span> - </span>

                                <span>
                                    @izin.BitisTarihi.ToString("dd.MM.yyyy")
                                </span>

                                <span class="mx-1">•</span>

                                <strong class="text-dark">
                                    @izin.GunSayisi gün
                                </strong>

                            </div>

                        </div>
                    }
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const departmanEtiketleri = [
                        @foreach (var departman in Model.DepartmanDagilimi)
            {
                @: "@Html.Raw(departman.DepartmanAdi.Replace("\"", "\\\""))",
            }
                    ];

        const departmanPersonelSayilari = [
                        @foreach (var departman in Model.DepartmanDagilimi)
            {
                @: @departman.PersonelSayisi,
            }
                    ];


        const grafikAlani =
            document.getElementById("departmanGrafik");

        if (grafikAlani) {

            new Chart(grafikAlani, {

                type: "bar",

                data: {

                    labels: departmanEtiketleri,

                    datasets: [
                        {
                            label: "Personel Sayısı",

                            data:
                                departmanPersonelSayilari,

                            borderWidth: 1
                        }
                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            }

                        }

                    },

                    plugins: {

                        legend: {
                            display: false
                        }

                    }

                }

            });

        }

    </script>
}